{% import '_default/macro.tabler.twig' as tabler %}
{% extends '_default/layout.base.twig' %}

{% block header_title %}{% trans "Edit building type" %}{% endblock header_title %}

{% block header_breadcrumb %}
	<li class="breadcrumb-item"><a href="/building/type">{% trans "Building types" %}</a></li>
	<li class="breadcrumb-item active" aria-current="page"><a href="#">{{ building_type.text_en_name }}</a></li>
{% endblock header_breadcrumb %}

{% block content %}
	{% if env.sticky_session.message == 'saved' %}
		{{ tabler.alert('success', 'The building type has been saved successfully.'|trans, '', true) }}
	{% endif %}

	<div class="row">
		<div class="col-12">
			<form method="post" action="/building/type/detail?id={{ building_type.id }}">
				<div class="card">
					<div class="card-header">
						<h3 class="card-title">{% trans "Building type" %}</h3>
					</div>
					<div class="card-body">
						{% include 'building/type/_fields.twig' with {'edit_mode': true} %}
					</div>
					<div class="card-footer text-end">
						<a href="/building/type" class="btn btn-link">{% trans "Cancel" %}</a>
						<button type="submit" class="btn btn-primary">{% trans "Save" %}</button>
					</div>
				</div>
			</form>
		</div>
	</div>
{% endblock %}
