{% if edit_mode %}
	<div class="mb-3 row">
		<label class="col-3 col-form-label">{% trans "Identifier" %}</label>
		<div class="col">
			<input type="text" class="form-control" value="{{ actor_role.identifier }}" disabled />
		</div>
	</div>
{% else %}
	<div class="mb-3 row">
		<label class="col-3 col-form-label">{% trans "Identifier" %}</label>
		<div class="col">
			<input type="text" name="actor_role[identifier]" class="form-control" value="{{ actor_role.identifier }}" />
		</div>
	</div>
{% endif %}
